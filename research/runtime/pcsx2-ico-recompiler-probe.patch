+static void IcoRecProbeMaybeLog(const u32 probe_pc)
+{
+	if (probe_pc != 0x00100008 && probe_pc != 0x001d27a8 && probe_pc != 0x00201ed4 && probe_pc != 0x0013f7a8)
+		return;
+
+	const u32 a0 = cpuRegs.GPR.n.a0.UL[0];
+	const u32 a1 = cpuRegs.GPR.n.a1.UL[0];
+	const u32 a2 = cpuRegs.GPR.n.a2.UL[0];
+	const u32 a3 = cpuRegs.GPR.n.a3.UL[0];
+	const u32 sp = cpuRegs.GPR.n.sp.UL[0];
+	const u32 ra = cpuRegs.GPR.n.ra.UL[0];
+	const u32 v0 = cpuRegs.GPR.n.v0.UL[0];
+	const u32 v1 = cpuRegs.GPR.n.v1.UL[0];
+	const u32 s0 = cpuRegs.GPR.n.s0.UL[0];
+	const u32 s1 = cpuRegs.GPR.n.s1.UL[0];
+	const u32 s2 = cpuRegs.GPR.n.s2.UL[0];
+	const u32 s3 = cpuRegs.GPR.n.s3.UL[0];
+	const u32 s4 = cpuRegs.GPR.n.s4.UL[0];
+	const u32 s7 = cpuRegs.GPR.n.s7.UL[0];
+	const u32 t0 = cpuRegs.GPR.n.t0.UL[0];
+
+	if (probe_pc == 0x0013f7a8 && (a3 != 0x13 || (a1 != 0x001d3a30 && ra != 0x00201edc)))
+		return;
+
+	FILE* fp = IcoRecProbeGetLogFile();
+	if (!fp)
+		return;
+
+	const char* label = "unknown";
+	if (probe_pc == 0x00100008)
+		label = "elf_entry_sentinel";
+	else if (probe_pc == 0x001d27a8)
+		label = "cloth_payload_init";
+	else if (probe_pc == 0x00201ed4)
+		label = "runtime_candidate_00201ed4";
+	else if (probe_pc == 0x0013f7a8)
+		label = "callback_register_a3_13";
+
+	std::fprintf(fp,
+		"{\"session\":\"ico_probe_rec\","
+		"\"label\":\"%s\","
+		"\"pc\":\"0x%08x\","
+		"\"cycle\":%llu,"
+		"\"regs\":{"
+		"\"a0\":\"0x%08x\","
+		"\"a1\":\"0x%08x\","
+		"\"a2\":\"0x%08x\","
+		"\"a3\":\"0x%08x\","
+		"\"sp\":\"0x%08x\","
+		"\"ra\":\"0x%08x\","
+		"\"v0\":\"0x%08x\","
+		"\"v1\":\"0x%08x\","
+		"\"s0\":\"0x%08x\","
+		"\"s1\":\"0x%08x\","
+		"\"s2\":\"0x%08x\","
+		"\"s3\":\"0x%08x\","
+		"\"s4\":\"0x%08x\","
+		"\"s7\":\"0x%08x\","
+		"\"t0\":\"0x%08x\"},"
+		"\"caller_probe\":{"
+		"\"ra_minus_8\":\"0x%08x\","
+		"\"ra_minus_4\":\"0x%08x\","
+		"\"ra\":\"0x%08x\"},"
+		"\"memory\":{",
+		label,
+		probe_pc,
+		static_cast<unsigned long long>(cpuRegs.cycle),
+		a0, a1, a2, a3, sp, ra, v0, v1, s0, s1, s2, s3, s4, s7, t0,
+		memRead32(ra - 8), memRead32(ra - 4), memRead32(ra));
+
+	if (probe_pc == 0x001d27a8)
+	{
+		std::fprintf(fp, "\"a1_plus_30_word\":\"0x%08x\",\"a1_words_32\":", memRead32(a1 + 0x30));
+		IcoRecProbeWriteWordArray(fp, a1, 32);
+		std::fprintf(fp, ",\"sp_words_16\":");
+		IcoRecProbeWriteWordArray(fp, sp, 16);
+	}
+	else if (probe_pc == 0x00201ed4)
+	{
+		std::fprintf(fp, "\"a1_word\":\"0x%08x\",\"v1_words_20\":", memRead32(a1));
+		IcoRecProbeWriteWordArray(fp, v1, 20);
+		std::fprintf(fp, ",\"s1_words_8\":");
+		IcoRecProbeWriteWordArray(fp, s1, 8);
+		std::fprintf(fp, ",\"s0_words_16\":");
+		IcoRecProbeWriteWordArray(fp, s0, 16);
+	}
+	else
+	{
+		std::fprintf(fp, "\"a1_word\":\"0x%08x\"", a1);
+	}
+
+	std::fprintf(fp, "}}\n");
+}
