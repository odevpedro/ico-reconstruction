# Deterministic replay fixture v1 — native-side synthetic scene 0x0F.
# Used by replay_runner_test and the CI reproducibility step. Not from a
# real PCSX2 session; the PCSX2-side recorder (runtime-dependent) will
# produce files with the same grammar.
VERSION 1
ISO_SHA1 -
SAVE_STATE -
WORLD_STATE_INIT 0x0F
FRAME_REF 0
# pad nibble: bit0=+x bit1=-x bit2=+z bit3=-z; magnitude 25 (walk tier)
F0 P00000000
F1 P00000000
F2 P00000000
F3 P00000001
F4 P00000001
F5 P00000001
F6 P00000001
F7 P00000001
F8 P00000000
F9 P00000000
F10 P00000000
F11 P00000000
# reserved world events (not yet consumed by the native runner)
E0 WORLD 0x0F 0x0F